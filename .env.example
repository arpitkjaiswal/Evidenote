# Generate a private secret, for example: `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-random-secret

# AI Gateway key used by the server for chat and note embeddings.
# https://vercel.com/docs/ai-gateway/authentication-and-byok
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key

# Optional: required for image artifact uploads.
# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Neon PostgreSQL connection string, including sslmode=require.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional: enables distributed rate limiting for chat requests.
REDIS_URL=
